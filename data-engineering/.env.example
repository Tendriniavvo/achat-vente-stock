# PostgreSQL analytique
ANALYTICS_POSTGRES_USER=analytics_user
ANALYTICS_POSTGRES_PASSWORD=analytics_password
ANALYTICS_POSTGRES_DB=gestion_stock_analytics
ANALYTICS_POSTGRES_HOST=postgres-analytics
ANALYTICS_POSTGRES_PORT=5432

# PostgreSQL opérationnel existant
# Depuis Docker, host.docker.internal permet généralement d'accéder au PostgreSQL local Windows.
SOURCE_POSTGRES_HOST=host.docker.internal
SOURCE_POSTGRES_PORT=5432
SOURCE_POSTGRES_DB=gestion_stock
SOURCE_POSTGRES_USER=postgres
SOURCE_POSTGRES_PASSWORD=postgres

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow metadata database
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# SMTP emails automatiques
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change_me
SMTP_MAIL_FROM=airflow@example.com
SMTP_STARTTLS=True
SMTP_SSL=False

# Destinataires métier
ALERT_STOCK_RECIPIENTS=stock@example.com,achats@example.com
ALERT_BUDGET_RECIPIENTS=finance@example.com,direction@example.com
DAILY_REPORT_RECIPIENTS=direction@example.com
